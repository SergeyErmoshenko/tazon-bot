# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-bot-token-here

# Твой Telegram chat_id (узнать у @userinfobot) — бот отвечает только тебе
ADMIN_CHAT_ID=123456789

# Времени проверок, через запятую (HH:MM), по локальному времени ноутбука
CHECK_TIMES=00:00,03:00,06:00,09:00,12:00,15:00,18:00,21:00

# Рандомное смещение расписания, минут (чтобы запросы не были «по расписанию»)
JITTER_MINUTES=15
